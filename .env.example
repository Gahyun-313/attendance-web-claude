# 브라우저(axios)가 실제로 요청을 보내는 주소 - 상대경로로 두고 Vite dev 프록시가 대신 넘겨줌
VITE_API_BASE_URL=/api

# Vite dev 프록시가 /api 요청을 실제로 전달할 백엔드 주소
# 실제 값(EC2 퍼블릭 IP)은 .env에 본인이 채워넣기 - .env는 gitignore 처리되어 커밋되지 않음
VITE_API_PROXY_TARGET=http://YOUR_EC2_PUBLIC_IP:8080

# 구글 OAuth 클라이언트 ID (구글 클라우드 콘솔에서 발급한 "웹 애플리케이션" 타입 클라이언트 ID)
# 백엔드가 요구하는 비밀값(client secret)이 아니라 프론트에서 공개적으로 쓰는 값이라 커밋해도 안전하지만,
# 프로젝트별로 값이 다르니 다른 값들과 동일하게 .env에만 실제 값을 채워넣기
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID

# 카카오 디벨로퍼스에 등록한 앱의 JavaScript 키 (REST API 키 아님 - 반드시 JavaScript 키)
VITE_KAKAO_JS_KEY=YOUR_KAKAO_JAVASCRIPT_KEY
